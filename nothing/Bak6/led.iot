@device esp32

pin R = pwm 13;
pin G = pwm 12;
pin B = pwm 14;

float r = 0.0;
float g = 0.0;
float b = 0.0;
float t = 0.0;

c setup {
    ledcSetup(0, 5000, 8);
    ledcSetup(1, 5000, 8);
    ledcSetup(2, 5000, 8);
    ledcAttachPin(13, 0);
    ledcAttachPin(12, 1);
    ledcAttachPin(14, 2);
    ledcWrite(0, 255);
    ledcWrite(1, 255);
    ledcWrite(2, 255);
}

every 10 {
    t = millis();

    r = 255 - (127.5 + 127.5 * sin(t * 0.001));
    g = 255 - (127.5 + 127.5 * sin(t * 0.001 + 2.094));
    b = 255 - (127.5 + 127.5 * sin(t * 0.001 + 4.189));

    ledcWrite(0, r);
    ledcWrite(1, g);
    ledcWrite(2, b);
}