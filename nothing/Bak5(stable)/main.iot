@device esp32

// ===== Pins =====
pin BTN    = input  4;
pin BUZZER = output 18;

// ===== Constants =====
const int FULL_BUDGET = 30000;
const int HOUR        = 3600000;
const int MAX_BURST   = 5000;
const int COOLDOWN    = 2000;

// ===== State =====
int  honkUsed        = 0;
int  lastReset       = 0;
int  burstStart      = 0;
int  lastReleaseTime = 0;
bool inBurst         = false;
bool inCooldown      = false;

// ===== Button events =====
on BTN.press {
    inBurst    = true;
    burstStart = millis();
}

on BTN.release {
    if (inBurst) {
        inBurst         = false;
        inCooldown      = true;
        lastReleaseTime = millis();
    }
    BUZZER = 0;
}

// ===== Setup =====
c setup {
    lastReset = millis();
}

// ===== Main loop =====
c loop {
    unsigned long now = millis();

    if (now - lastReset >= HOUR) {
        honkUsed  = 0;
        lastReset = now;
    }

    if (inCooldown) {
        if (now - lastReleaseTime >= COOLDOWN) {
            inCooldown = false;
        } else {
            digitalWrite(BUZZER_PIN, LOW);
            return;
        }
    }

    if (inBurst) {
        if (now - burstStart >= MAX_BURST) {
            inBurst         = false;
            inCooldown      = true;
            lastReleaseTime = now;
            digitalWrite(BUZZER_PIN, LOW);
            return;
        }

        if (honkUsed < FULL_BUDGET) {
            digitalWrite(BUZZER_PIN, HIGH);
            honkUsed += 10;
        } else {
            digitalWrite(BUZZER_PIN, LOW);
        }
    } else {
        digitalWrite(BUZZER_PIN, LOW);
    }
}