// ── IOTIFT test program ──

@device esp32

pin LED  = output 12;
pin BTN  = input 5;
pin TEMP = analog 34;
pin FAN  = output 18;

int count = 0;
float tempVal = 0.0;
bool fanOn = false;

extern fn esp_restart();

on BTN.press {
    LED = 1;
    LED = 0 after 200;
}

on BTN.release {
    LED = 0;
}

every 1000 as ticker {
    count += 1;
    print(count);
    if (count == 10) {
        stop ticker;
    }
}

every 500 {
    tempVal = 25.5;
}

void loop() {
    if (count == 100) {
        esp_restart();
    }
}
