@device esp32

// ─────────────────────────────────────────
//  ARGB WS2812B SNIFFER — written in Iotift
//
//  WIRING:
//  ARGB Pin 2 (Data) → [1kΩ] → GPIO4
//                              └→ [2kΩ] → GND
//  ARGB Pin 3 (GND)  → ESP32 GND
// ─────────────────────────────────────────

// RMT + ringbuffer setup injected as raw C
c header {
    #include <driver/rmt.h>

    #define GPIO_ARGB_DATA   4
    #define RMT_RX_CHANNEL   RMT_CHANNEL_0
    #define MAX_LEDS         300

    // WS2812B timing @ 10MHz (100ns/tick)
    #define WS2812_T0H_MIN   2
    #define WS2812_T0H_MAX   5
    #define WS2812_T1H_MIN   6
    #define WS2812_T1H_MAX   10

    struct RGB {
        uint8_t r, g, b;
    };

    RGB           ledFrame[MAX_LEDS];
    int           ledCount = 0;
    RingbufHandle_t rb     = NULL;
}

// ── RMT init ──────────────────────────────
c global {
    void setupRMT() {
        rmt_config_t cfg = RMT_DEFAULT_CONFIG_RX(
            (gpio_num_t)GPIO_ARGB_DATA,
            RMT_RX_CHANNEL
        );
        cfg.clk_div = 8;
        cfg.rx_config.filter_en           = true;
        cfg.rx_config.filter_ticks_thresh = 2;
        cfg.rx_config.idle_threshold      = 500;

        rmt_config(&cfg);
        rmt_driver_install(RMT_RX_CHANNEL, 2048, 0);
        rmt_get_ringbuf_handle(RMT_RX_CHANNEL, &rb);
        rmt_rx_start(RMT_RX_CHANNEL, true);

        Serial.println("[RMT] Started on GPIO 4");
    }

    // ── bit decoder ──
    bool decodePulse(rmt_item32_t item, uint8_t &bit) {
        if (item.level0 != 1) return false;          // must be high-first
        uint32_t h = item.duration0;
        if (h >= WS2812_T0H_MIN && h <= WS2812_T0H_MAX) { bit = 0; return true; }
        if (h >= WS2812_T1H_MIN && h <= WS2812_T1H_MAX) { bit = 1; return true; }
        return false;
    }

    // ── frame decoder ──
    // WS2812B sends GRB, MSB first, 24 bits per LED
    void decodeFrame(rmt_item32_t* items, size_t itemCount) {
        ledCount    = 0;
        uint32_t grb = 0;
        int bitIndex = 0;

        for (size_t i = 0; i < itemCount; i++) {
            uint8_t bit;
            if (!decodePulse(items[i], bit)) continue;

            grb = (grb << 1) | bit;
            bitIndex++;

            if (bitIndex == 24) {
                uint8_t g = (grb >> 16) & 0xFF;
                uint8_t r = (grb >> 8)  & 0xFF;
                uint8_t b = (grb)       & 0xFF;
                if (ledCount < MAX_LEDS) {
                    ledFrame[ledCount++] = {r, g, b};
                }
                grb      = 0;
                bitIndex = 0;
            }
        }
    }

    // ── serial print ──
    void printFrame() {
        Serial.println();
        Serial.println("=================================");
        Serial.printf("FRAME: %d LEDs\n", ledCount);
        Serial.println("=================================");
        for (int i = 0; i < ledCount; i++) {
            Serial.printf(
                "LED[%03d]  R:%03d G:%03d B:%03d   #%02X%02X%02X\n",
                i,
                ledFrame[i].r, ledFrame[i].g, ledFrame[i].b,
                ledFrame[i].r, ledFrame[i].g, ledFrame[i].b
            );
        }
    }
}

// ── call setupRMT() inside Arduino setup() ──
c setup {
    setupRMT();
    Serial.println("Waiting for ARGB data...");
}

// ── main poll loop ──
c loop {
    if (!rb) return;

    size_t rx_size = 0;
    rmt_item32_t* items = (rmt_item32_t*) xRingbufferReceive(
        rb, &rx_size, pdMS_TO_TICKS(100)
    );

    if (items) {
        size_t itemCount = rx_size / sizeof(rmt_item32_t);
        if (itemCount >= 24) {
            decodeFrame(items, itemCount);
            if (ledCount > 0) {
                printFrame();
            }
        }
        vRingbufferReturnItem(rb, (void*) items);
    }
}
