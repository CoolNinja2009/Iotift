{
  "pin": {
    "prefix": "pin",
    "body": "pin ${1:NAME} = ${2|output,input,analog,pwm,i2c,spi|} ${3:NUMBER};",
    "description": "Pin declaration"
  },
  "pin with config": {
    "prefix": "pin_config",
    "body": [
      "pin ${1:NAME} = ${2|output,input,analog,pwm|} ${3:NUMBER} {",
      "    pull: ${4|up,down,none|},",
      "    debounce: ${5:50}ms",
      "};"
    ],
    "description": "Pin declaration with configuration block"
  },
  "let": {
    "prefix": "let",
    "body": "let ${1:name} = ${2:value};",
    "description": "Immutable variable (type inferred)"
  },
  "var": {
    "prefix": "var",
    "body": "var ${1:name}: ${2:type} = ${3:value};",
    "description": "Mutable variable with explicit type"
  },
  "const": {
    "prefix": "const",
    "body": "const ${1:NAME} = ${2:value};",
    "description": "Compile-time constant"
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "    ${3}",
      "}"
    ],
    "description": "Function declaration"
  },
  "fn with return type": {
    "prefix": "fn_typed",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} {",
      "    ${4}",
      "}"
    ],
    "description": "Function declaration with return type"
  },
  "isr fn": {
    "prefix": "isr_fn",
    "body": [
      "isr fn ${1:name}() {",
      "    ${2}",
      "}"
    ],
    "description": "ISR function declaration"
  },
  "extern fn": {
    "prefix": "extern_fn",
    "body": "extern fn ${1:name}(${2:params});",
    "description": "External C function declaration"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:type},",
      "}"
    ],
    "description": "Struct declaration"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:Variant1},",
      "    ${3:Variant2} = ${4:5},",
      "}"
    ],
    "description": "Enum declaration"
  },
  "type alias": {
    "prefix": "type_alias",
    "body": "type ${1:Alias} = ${2:u32};",
    "description": "Type alias"
  },
  "every": {
    "prefix": "every",
    "body": [
      "every ${1:500}ms {",
      "    ${2}",
      "}"
    ],
    "description": "Repeating timer block"
  },
  "every named": {
    "prefix": "every_named",
    "body": [
      "every ${1:1}s as ${2:label} {",
      "    ${3}",
      "}"
    ],
    "description": "Named repeating timer block"
  },
  "every offset": {
    "prefix": "every_offset",
    "body": [
      "every ${1:1}s offset ${2:100}ms {",
      "    ${3}",
      "}"
    ],
    "description": "Repeating timer with offset"
  },
  "after": {
    "prefix": "after",
    "body": [
      "after ${1:5}s {",
      "    ${2}",
      "}"
    ],
    "description": "One-shot timer block"
  },
  "on event": {
    "prefix": "on_event",
    "body": [
      "on ${1:PIN}.${2|press,release,change,rising,falling|} {",
      "    ${3}",
      "}"
    ],
    "description": "Pin event handler"
  },
  "on threshold": {
    "prefix": "on_threshold",
    "body": [
      "on ${1:PIN} ${2|>,<,>=,<=,==|} ${3:50.0} {",
      "    ${4}",
      "}"
    ],
    "description": "Analog threshold event"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "}"
    ],
    "description": "If statement"
  },
  "if else": {
    "prefix": "if_else",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} else {",
      "    ${3}",
      "}"
    ],
    "description": "If-else statement"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${2}",
      "}"
    ],
    "description": "While loop"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:N}; ${1:i} += 1) {",
      "    ${3}",
      "}"
    ],
    "description": "C-style for loop"
  },
  "loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "    ${1}",
      "}"
    ],
    "description": "Infinite loop"
  },
  "tick": {
    "prefix": "tick",
    "body": [
      "tick {",
      "    ${1}",
      "}"
    ],
    "description": "Main loop tick handler"
  },
  "defer": {
    "prefix": "defer",
    "body": [
      "defer {",
      "    ${1}",
      "}"
    ],
    "description": "Deferred execution block"
  },
  "print": {
    "prefix": "print",
    "body": "print(\"${1}\");",
    "description": "Print to serial"
  },
  "println": {
    "prefix": "println",
    "body": "println(\"${1}\");",
    "description": "Print line to serial"
  },
  "device": {
    "prefix": "device",
    "body": "@device ${1|esp32|}",
    "description": "Device declaration"
  },
  "config": {
    "prefix": "config",
    "body": "@config scheduler_slots = ${1:16};",
    "description": "Scheduler configuration"
  },
  "i2c": {
    "prefix": "i2c",
    "body": "i2c ${1:bus} { sda: ${2:21}, scl: ${3:22}, speed: ${4:100kHz} };",
    "description": "I2C peripheral declaration"
  },
  "spi": {
    "prefix": "spi",
    "body": "spi ${1:bus} { mosi: ${2:23}, miso: ${3:19}, sck: ${4:18}, speed: ${5:10MHz} };",
    "description": "SPI peripheral declaration"
  },
  "uart": {
    "prefix": "uart",
    "body": "uart ${1:serial} { tx: ${2:17}, rx: ${3:16}, baud: ${4:9600} };",
    "description": "UART peripheral declaration"
  },
  "import": {
    "prefix": "import",
    "body": "import \"${1:file.iot}\";",
    "description": "Import statement"
  },
  "import selective": {
    "prefix": "import_select",
    "body": "import { ${1:Name1}, ${2:Name2} } from \"${3:file.iot}\";",
    "description": "Selective import statement"
  },
  "c block": {
    "prefix": "c_block",
    "body": [
      "c ${1|header,global,setup,loop,isr|} {",
      "    ${2}",
      "}"
    ],
    "description": "Raw C code injection block"
  },
  "wifi sta": {
    "prefix": "wifi",
    "body": [
      "wifi ${1:home} {",
      "    ssid: \"${2:MyWiFi}\",",
      "    password: \"${3:mypassword}\"",
      "};"
    ],
    "description": "WiFi STA declaration"
  },
  "wifi sta full": {
    "prefix": "wifi_sta",
    "body": [
      "wifi ${1:home} {",
      "    ssid: \"${2:MyWiFi}\",",
      "    password: \"${3:mypassword}\",",
      "    hostname: \"${4:iotift-device}\",",
      "    connect_timeout: ${5:30s},",
      "    retry: ${6|fixed,none,forever,exponential|},",
      "    power_save: ${7|none,light,deep|}",
      "};"
    ],
    "description": "WiFi STA declaration with all options"
  },
  "wifi sta static ip": {
    "prefix": "wifi_static",
    "body": [
      "wifi ${1:home} {",
      "    ssid: \"${2:MyWiFi}\",",
      "    password: \"${3:mypassword}\",",
      "    static_ip: \"${4:192.168.1.100}\",",
      "    gateway: \"${5:192.168.1.1}\",",
      "    subnet: \"${6:255.255.255.0}\",",
      "    dns: \"${7:8.8.8.8}\"",
      "};"
    ],
    "description": "WiFi STA declaration with static IP"
  },
  "wifi ap": {
    "prefix": "wifi_ap",
    "body": [
      "wifi ${1:myAP} {",
      "    mode: ap,",
      "    ssid: \"${2:MyHotspot}\",",
      "    password: \"${3:ap_password}\",",
      "    channel: ${4:1},",
      "    max_clients: ${5:8}",
      "};"
    ],
    "description": "WiFi AP declaration"
  },
  "wifi ap open": {
    "prefix": "wifi_ap_open",
    "body": [
      "wifi ${1:guest} {",
      "    mode: ap,",
      "    ssid: \"${2:FreeWiFi}\",",
      "    channel: ${3:6},",
      "    max_clients: ${4:4}",
      "};"
    ],
    "description": "WiFi open AP declaration (no password)"
  },
  "wifi retry custom": {
    "prefix": "wifi_retry",
    "body": [
      "retry: custom {",
      "    count: ${1:5},",
      "    interval: ${2:10s},",
      "    max_interval: ${3:60s},",
      "    backoff: ${4|fixed,exponential|}",
      "}"
    ],
    "description": "WiFi custom retry policy"
  },
  "on wifi connect": {
    "prefix": "on_wifi_connect",
    "body": [
      "on ${1:home}.connect {",
      "    print(\"Connected! IP: \" + ${1:home}.ip);",
      "}"
    ],
    "description": "WiFi connect event handler"
  },
  "on wifi disconnect": {
    "prefix": "on_wifi_disconnect",
    "body": [
      "on ${1:home}.disconnect {",
      "    print(\"Disconnected. State: \" + ${1:home}.state);",
      "}"
    ],
    "description": "WiFi disconnect event handler"
  },
  "on wifi got_ip": {
    "prefix": "on_wifi_got_ip",
    "body": [
      "on ${1:home}.got_ip {",
      "    print(\"Got IP: \" + ${1:home}.ip);",
      "}"
    ],
    "description": "WiFi got_ip event handler"
  },
  "on wifi scan_done": {
    "prefix": "on_wifi_scan_done",
    "body": [
      "on ${1:home}.scan_done {",
      "    int count = scan_result_count();",
      "    for int i = 0; i < count; i += 1 {",
      "        print(scan_result_ssid(i));",
      "        print(\": \");",
      "        println(scan_result_rssi(i));",
      "    }",
      "}"
    ],
    "description": "WiFi scan_done event handler with result accessors"
  },
  "on wifi client_join": {
    "prefix": "on_wifi_client_join",
    "body": [
      "on ${1:ap_if}.client_join {",
      "    print(\"Client joined. Total: \" + ${1:ap_if}.clients);",
      "}"
    ],
    "description": "WiFi AP client_join event handler"
  },
  "on wifi client_leave": {
    "prefix": "on_wifi_client_leave",
    "body": [
      "on ${1:ap_if}.client_leave {",
      "    print(\"Client left. Total: \" + ${1:ap_if}.clients);",
      "}"
    ],
    "description": "WiFi AP client_leave event handler"
  },
  "wifi dual mode": {
    "prefix": "wifi_dual",
    "body": [
      "wifi ${1:sta_if} { ssid: \"${2:HomeWiFi}\"; password: \"${3:pass}\"; };",
      "wifi ${4:ap_if}  { mode: ap; ssid: \"${5:IotiftAP}\"; password: \"${6:ap123}\"; };",
      "",
      "on ${1:sta_if}.connect {",
      "    print(\"STA connected!\");",
      "}",
      "",
      "on ${4:ap_if}.client_join {",
      "    print(\"Client joined AP!\");",
      "}"
    ],
    "description": "WiFi dual mode (STA + AP)"
  }
}
