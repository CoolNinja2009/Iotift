{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Iotift",
  "scopeName": "source.iot",
  "fileTypes": [".iot"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#c-blocks" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.iot",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.iot" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.iot" } },
          "patterns": [{ "include": "#todo-tags" }]
        },
        {
          "name": "comment.line.double-slash.iot",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.iot" } },
          "patterns": [{ "include": "#todo-tags" }]
        }
      ]
    },
    "todo-tags": {
      "patterns": [
        {
          "name": "keyword.todo.iot",
          "match": "\\b(TODO|FIXME|HACK|XXX|OPTIMIZE|REVIEW)\\b"
        },
        {
          "name": "keyword.note.iot",
          "match": "\\b(NOTE|INFO|IDEA)\\b"
        },
        {
          "name": "keyword.warning.iot",
          "match": "\\b(BUG|WARNING|DANGER|CAUTION|HACK)\\b"
        }
      ]
    },
    "c-blocks": {
      "patterns": [
        {
          "name": "meta.embedded.block.c.iot",
          "begin": "\\b(c)\\s+(header|global|setup|loop|isr)\\s*\\{",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "keyword.control.c-block.iot" },
            "2": { "name": "entity.name.tag.c-scope.iot" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.iot" }
          },
          "patterns": [
            { "include": "source.c" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.iot",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.iot" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.iot" } },
          "patterns": [
            {
              "name": "constant.character.escape.iot",
              "match": "\\\\[nrt\\\\\"'0abefv]|\\\\x[0-9A-Fa-f]{2}|\\\\u[0-9A-Fa-f]{4}|\\\\."
            },
            {
              "name": "keyword.operator.interpolation.iot",
              "match": "\\{[^}]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.iot",
          "match": "'(?:\\\\[nrt\\\\\"'0abefv]|\\\\x[0-9A-Fa-f]{2}|\\\\u[0-9A-Fa-f]{4}|[^'\\\\])'",
          "captures": {
            "0": { "name": "string.quoted.single.iot" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.iot",
          "match": "@(device|target|include|config)\\b",
          "captures": {
            "0": { "name": "keyword.directive.iot" },
            "1": { "name": "entity.name.tag.directive.iot" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.iot",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.control.loop.iot",
          "match": "\\b(while|for|loop|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.iot",
          "match": "\\b(return|defer)\\b"
        },
        {
          "name": "keyword.control.event.iot",
          "match": "\\b(every|after|on|schedule|tick|stop|offset|as)\\b"
        },
        {
          "name": "keyword.declaration.function.iot",
          "match": "\\b(fn|extern|isr)\\b"
        },
        {
          "name": "keyword.declaration.variable.iot",
          "match": "\\b(let|var|const|volatile|sizeof)\\b"
        },
        {
          "name": "keyword.declaration.type.iot",
          "match": "\\b(struct|enum|type)\\b"
        },
        {
          "name": "keyword.declaration.pin.iot",
          "match": "\\b(pin)\\b"
        },
        {
          "name": "keyword.other.import.iot",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.other.print.iot",
          "match": "\\b(print|println)\\b"
        },
        {
          "name": "storage.type.modifier.void.iot",
          "match": "\\bvoid\\b"
        },
        {
          "name": "keyword.hardware.direction.iot",
          "match": "\\b(input|output|analog|digital)\\b"
        },
        {
          "name": "keyword.hardware.peripheral.iot",
          "match": "\\b(pwm|adc|dac|uart|spi|i2c)\\b"
        },
        {
          "name": "keyword.hardware.event.iot",
          "match": "\\b(rising|falling|change|press|release)\\b"
        },
        {
          "name": "keyword.hardware.wifi.iot",
          "match": "\\b(wifi)\\b"
        },
        {
          "name": "keyword.hardware.wifi.mode.iot",
          "match": "\\b(sta|ap)\\b"
        },
        {
          "name": "keyword.hardware.wifi.event.iot",
          "match": "\\b(connect|disconnect|got_ip|scan_done|client_join|client_leave)\\b"
        },
        {
          "name": "keyword.hardware.wifi.method.iot",
          "match": "\\b(scan)\\b"
        },
        {
          "name": "keyword.hardware.wifi.retry.iot",
          "match": "\\b(none|fixed|forever|exponential|custom|retry)\\b"
        },
        {
          "name": "entity.name.tag.wifi.config.iot",
          "match": "\\b(ssid|password|hostname|connect_timeout|power_save|static_ip|gateway|subnet|dns|channel|max_clients|hidden|mode|backoff|interval|max_interval|count)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.fixed.iot",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64)\\b"
        },
        {
          "name": "storage.type.builtin.iot",
          "match": "\\b(int|uint|float|bool|str|char)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.iot",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.iot",
          "match": "\\bfalse\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.time.iot",
          "match": "\\b[0-9][0-9_]*(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.float.hex.iot",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\.[0-9A-Fa-f][0-9A-Fa-f_]*(?:[pP][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.iot",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.iot",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.iot",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.scientific.iot",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.iot",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.iot",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.iot",
          "match": "\\b(millis|micros|delay|delay_us|digitalRead|digitalWrite|pinMode|toggle|serialBegin|serialPrint|serialRead|serialAvailable|i2cBegin|i2cRead|i2cWrite|i2cScan|spiBegin|spiTransfer|pwmSetup|pwmWrite|pwmStop|sin|cos|tan|sqrt|abs|pow|floor|ceil|round|log|exp|scan_result_count|scan_result_ssid|scan_result_rssi|scan_result_channel)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.call.iot",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.iot" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.iot",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.assignment.iot",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.iot",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.iot",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.iot",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.iot",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.arrow.iot",
          "match": "->"
        },
        {
          "name": "keyword.operator.member.iot",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.iot",
          "match": ";"
        },
        {
          "name": "punctuation.separator.iot",
          "match": ","
        },
        {
          "name": "punctuation.section.braces.iot",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.section.parens.iot",
          "match": "[\\(\\)]"
        },
        {
          "name": "punctuation.section.brackets.iot",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.annotation.iot",
          "match": "@"
        },
        {
          "name": "punctuation.separator.colon.iot",
          "match": ":"
        }
      ]
    }
  }
}
