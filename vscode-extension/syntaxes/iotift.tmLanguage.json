{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Iotift",
  "scopeName": "source.iot",
  "fileTypes": [".iot"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#c-blocks"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.iot",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.iot"
            }
          }
        },
        {
          "name": "comment.line.double-slash.iot",
          "begin": "//",
          "end": "$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.iot"
            }
          }
        }
      ]
    },
    "c-blocks": {
      "patterns": [
        {
          "name": "meta.embedded.block.c.iot",
          "begin": "\\b(c)\\s+(header|global|setup|loop|isr)\\s*\\{",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.c-block.iotift"
            },
            "2": {
              "name": "entity.name.tag.c-scope.iotift"
            }
          },
          "patterns": [
            {
              "include": "source.c"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.iot",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.iot",
              "match": "\\\\[nrt\\\\\"'0]|\\\\x[0-9A-Fa-f]{2}"
            },
            {
              "name": "keyword.operator.interpolation.iot",
              "match": "\\{[^}]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.iot",
          "match": "'(\\\\[nrt\\\\\"'0]|\\\\x[0-9A-Fa-f]{2}|[^'\\\\])'",
          "captures": {
            "0": {
              "name": "string.quoted.single.iot"
            }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.device.iot",
          "match": "@device\\b"
        },
        {
          "name": "keyword.directive.config.iot",
          "match": "@config\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.iot",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.control.loop.iot",
          "match": "\\b(while|for|loop|break|continue)\\b"
        },
        {
          "name": "keyword.control.iot",
          "match": "\\b(return|defer|as|sizeof)\\b"
        },
        {
          "name": "keyword.declaration.iot",
          "match": "\\b(let|var|const|fn|isr|extern|struct|enum|type)\\b"
        },
        {
          "name": "keyword.qualifier.iot",
          "match": "\\b(volatile)\\b"
        },
        {
          "name": "keyword.other.iot",
          "match": "\\b(import|from|pin|device|config|tick|stop|print|println|millis)\\b"
        },
        {
          "name": "keyword.event.iot",
          "match": "\\b(every|after|on|offset|as)\\b"
        },
        {
          "name": "keyword.direction.iot",
          "match": "\\b(input|output|analog|pwm|i2c|spi|uart)\\b"
        },
        {
          "name": "keyword.event-type.iot",
          "match": "\\b(press|release|change|rising|falling)\\b"
        },
        {
          "name": "keyword.config.iot",
          "match": "\\b(pull|up|down|none|debounce|freq|resolution|sda|scl|speed|mosi|miso|sck|mode|tx|rx|baud)\\b"
        },
        {
          "name": "storage.type.modifier.iot",
          "match": "\\b(void)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.iot",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64)\\b"
        },
        {
          "name": "storage.type.iot",
          "match": "\\b(int|float|bool|char|str)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.iot",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.iot",
          "match": "\\bfalse\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.time.iot",
          "match": "\\b[0-9][0-9_]*(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.float.hex.iot",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\.[0-9A-Fa-f][0-9A-Fa-f_]*(?:[pP][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.iot",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.iot",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.iot",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.iot",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.iot",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.iot",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "support.function.stdlib.iot",
          "match": "\\b(millis|micros|delay|delay_us|digitalRead|digitalWrite|pinMode|toggle|serialBegin|serialPrint|serialRead|serialAvailable|i2cBegin|i2cRead|i2cWrite|i2cScan|spiBegin|spiTransfer|pwmSetup|pwmWrite|pwmStop|sin|cos|tan|sqrt|abs|pow|floor|ceil|round|log|exp)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.iot",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
        },
        {
          "name": "keyword.operator.comparison.iot",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.iot",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.iot",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.iot",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.arrow.iot",
          "match": "->"
        },
        {
          "name": "keyword.operator.member.iot",
          "match": "\\."
        },
        {
          "name": "punctuation.terminator.iot",
          "match": ";"
        },
        {
          "name": "punctuation.separator.iot",
          "match": ","
        },
        {
          "name": "punctuation.definition.annotation.iot",
          "match": "@"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.iot",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
