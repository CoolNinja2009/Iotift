@device esp32

pin LED = output 2;
pin PWM_PIN = pwm 13;
pin BTN = input 4;

int counter = 0;
int phase = 0;
bool armed = true;
float temp_avg = 0.0;

PWM_PIN.setup(5000, 8);

every 100 {
    counter = counter + 1;
    phase = counter % 4;

    if phase == 0 {
        LED = 1;
    }
    if phase == 1 {
        LED = 0;
    }
    if phase == 2 {
        LED = 1;
    }
    if phase == 3 {
        LED = 0;
    }

    if armed {
        int duty = counter * 10;
        if duty > 255 {
            duty = 255;
        }
        PWM_PIN.write(duty);
    }

    temp_avg = temp_avg + 1.5;
}

every 250 {
    if armed {
        armed = false;
    }
    if armed == false {
        armed = true;
    }
}

on BTN.press {
    counter = 0;
    phase = 0;
    LED = 0;
    PWM_PIN.write(0);
    armed = true;
}
